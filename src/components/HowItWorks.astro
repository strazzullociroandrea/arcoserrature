---
const steps = [
    {
        number: "01",
        title: "Contattaci",
        description:
            "Chiamaci per spiegare brevemente il problema o il tipo di intervento di cui hai bisogno.",
    },
    {
        number: "02",
        title: "Invia le foto su WhatsApp",
        description:
            "Manda le foto della serratura, della porta o della serranda al numero WhatsApp che ti indichiamo durante la chiamata.",
    },
    {
        number: "03",
        title: "Ricevi il preventivo",
        description:
            "Valutiamo il caso dalle foto ricevute e ti comunichiamo un preventivo chiaro prima di procedere.",
    },
    {
        number: "04",
        title: "Esecuzione del lavoro",
        description:
            "Concordiamo l'uscita a domicilio ed eseguiamo l'apertura, la riparazione o la sostituzione.",
    },
];
---

<section id="come-funziona" class="w-full py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
        Metodo di Lavoro
      </span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-black tracking-tight ">
                Come funziona l'intervento
            </h2>
            <p class="mt-3 text-base text-zinc-400">
                Un processo semplice, trasparente e senza sorprese.
            </p>
        </div>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {steps.map((step) => (
                    <div class="relative rounded-3xl bg-zinc-950 border border-zinc-800 p-6 sm:p-7">
          <span class="inline-block text-3xl font-black text-amber-400/90 tracking-tight mb-4">
            {step.number}
          </span>
                        <h3 class="text-lg font-bold text-white mb-2">{step.title}</h3>
                        <p class="text-sm text-zinc-400 leading-relaxed">{step.description}</p>
                    </div>
            ))}
        </div>
    </div>
</section>