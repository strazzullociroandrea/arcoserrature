---
const categories = [
    {
        title: "Porte Blindate e Sicurezza",
        description: "Aggiornamento e messa in sicurezza di porte d'ingresso e uscite di emergenza.",
        items: [
            "Apertura porta blindata bloccata",
            "Conversione da doppia mappa a cilindro europeo",
            "Sostituzione cilindri con chiavi codificate",
            "Montaggio defender magnetici anti-scasso",
            "Installazione serrature elettroniche",
            "Installazione e sostituzione maniglioni antipanico",
            "Serrature per porte di sicurezza",
        ],
    },
    {
        title: "Apertura e Riparazioni",
        description: "Sblocco e manutenzione su porte, serramenti e infissi metallici.",
        items: [
            "Riparazione di serrature per porte",
            "Apertura porte bloccate",
            "Installazione serrature",
            "Riparazione serrature finestre e inferriate",
            "Riparazioni generali su infissi e chiusure",
        ],
    },
    {
        title: "Serrande e Box",
        description: "Manutenzione meccanica, sblocco e automazione di serrande avvolgibili e basculanti.",
        items: [
            "Apertura e sostituzione serrature box",
            "Cambio molle serrande",
            "Motorizzazione serrande",
            "Sblocco serrande inceppate o fuori guida",
        ],
    },
    {
        title: "Casseforti e Sfratti Giudiziari",
        description: "Assistenza tecnica per privati, aziende, condomini e studi legali.",
        items: [
            "Apertura cassaforte bloccata",
            "Apertura porte per sfratti giudiziari",
            "Sostituzione immediata serrature post-esecuzione",
        ],
    },
];
---

<section id="servizi" class="w-full py-14 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
        Cosa Facciamo
      </span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-black tracking-tight ">
                I nostri servizi
            </h2>
            <p class="mt-4 text-base text-zinc-400 leading-relaxed">
                Interveniamo a domicilio su porte blindate, box, inferriate e casseforti.
            </p>
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            {categories.map((cat) => (
                    <div class="flex flex-col justify-between rounded-3xl bg-zinc-950 border border-zinc-800 hover:border-amber-500/40 p-6 sm:p-8 transition-colors">
                        <div>
                            <div class="flex items-center justify-between gap-4 mb-4">
                                <h3 class="text-xl font-bold text-amber-400">{cat.title}</h3>

                            </div>
                            <p class="text-sm text-zinc-400 mb-6">{cat.description}</p>
                            <ul class="space-y-2.5 text-sm text-zinc-200">
                                {cat.items.map((item) => (
                                        <li class="flex items-start gap-2.5">
                                            <span class="mt-0.5 text-amber-400 font-bold">✓</span>
                                            <span>{item}</span>
                                        </li>
                                ))}
                            </ul>
                        </div>
                    </div>
            ))}
        </div>
    </div>
</section>