---
import {Dot, Phone} from "lucide-react";
---
<section id="hero" class="relative w-full bg-zinc-950 pt-28 pb-14 sm:pt-32 sm:pb-20 lg:py-24 border-b border-zinc-800 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-amber-500/10 blur-[120px] pointer-events-none rounded-full"></div>

    <div class="relative mx-auto flex w-full max-w-7xl flex-col justify-center px-4 sm:px-6 lg:px-8">

        <div class="mb-6 text-center md:text-left">
            <div class="inline-flex items-center gap-2 uppercase px-4 py-1.5 text-xs font-semibold text-amber-400 shadow-sm sm:text-sm ">
                Fabbro <span><Dot className=""/></span> Intervento a Domicilio
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 sm:gap-10 lg:gap-12 items-center">

            <div class="md:col-span-7 text-center md:text-left flex flex-col justify-center">
                <h1 class="uppercase text-3xl font-black tracking-tight text-white sm:text-6xl lg:text-7xl leading-[1.08]">
                    Arco<span class="text-amber-400">serrature</span>
                </h1>

                <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg font-normal leading-relaxed text-zinc-300 md:mx-0">
                    Arcoserrature Fabbro: apertura porte blindate, sostituzione serrature, apertura casseforti e
                    riparazione di serrande e tapparelle, con interventi rapidi e professionali.

                </p>

                <div class="mt-8 flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4">
                    <a
                            href="tel:+393333107476"
                            class="group inline-flex w-full sm:w-auto items-center justify-center space-x-3 rounded-2xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 px-8 py-4 text-base font-extrabold text-zinc-950 shadow-lg shadow-amber-500/25 active:scale-95 transition-all duration-200 sm:text-lg"
                    >
                        <div class="p-1.5 bg-zinc-950/15 rounded-xl group-hover:rotate-12 transition-transform">
                            <Phone className="w-5 h-5"/>
                        </div>
                        <span>Chiama 333 310 7476</span>
                    </a>
                </div>

                <div class="mt-8 flex flex-wrap items-center justify-center md:justify-start gap-2.5 text-xs sm:text-sm text-zinc-300">
                    <span class="rounded-lg bg-zinc-900 border border-zinc-800 px-3 py-1.5">Cilindri Europei e Defender</span>
                    <span class="rounded-lg bg-zinc-900 border border-zinc-800 px-3 py-1.5">Serrande e Molle</span>
                    <span class="rounded-lg bg-zinc-900 border border-zinc-800 px-3 py-1.5">Casseforti e Box</span>
                    <span class="rounded-lg bg-zinc-900 border border-zinc-800 px-3 py-1.5">Sfratti Giudiziari</span>
                </div>
            </div>

            <div class="md:col-span-5">
                <div class="rounded-3xl bg-zinc-900/90 border border-zinc-800 p-6 sm:p-7 shadow-2xl">
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">
                        Servizi Principali
                    </p>
                    <ul class="space-y-3 text-sm text-zinc-200">
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 text-amber-400 font-bold">✓</span>
                            <span>Apertura porte blindate</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 text-amber-400 font-bold">✓</span>
                            <span>Conversione da <strong>doppia mappa a cilindro europeo</strong> con chiavi codificate</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 text-amber-400 font-bold">✓</span>
                            <span>Montaggio <strong>defender magnetici</strong>, serrature elettroniche e maniglioni antipanico</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 text-amber-400 font-bold">✓</span>
                            <span>Apertura e riparazione <strong>casseforti</strong>, serrature box, finestre e inferriate</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 text-amber-400 font-bold">✓</span>
                            <span><strong>Motorizzazione serrande</strong>, cambio molle e assistenza <strong>sfratti giudiziari</strong></span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</section>