---
import {Phone} from "lucide-react"
---

<header class="fixed w-full top-0 z-50 backdrop-blur-md bg-white/90 border-b border-zinc-200/80 shadow-sm transition-all">
    <div class="max-w-7xl px-3 sm:px-6 mx-auto">
        <div class="flex items-center justify-between h-18 sm:h-20">

            <a href="/" class="flex items-center space-x-3 sm:space-x-3.5 group">
                <div class="relative flex items-center justify-center w-11 h-11 sm:w-13 sm:h-13 rounded-xl sm:rounded-2xl bg-amber-50 border border-amber-200/80 shadow-sm overflow-hidden shrink-0 transition-transform duration-200 group-hover:scale-105">
                    <img src="/favicon-96x96.png" alt="Fabbro Lissone" class="w-full h-full object-contain p-1.5"/>
                </div>
                <div>
                    <span class="text-base sm:text-xl font-extrabold tracking-tight text-zinc-900 block leading-tight">
                        Arco <span class="text-amber-600">Serrature</span>
                    </span>
                    <div class="flex items-center text-[11px] sm:text-xs text-zinc-500 font-normal mt-0.5">
                        <span class="truncate max-w-44 sm:max-w-none">Fabbro</span>
                    </div>
                </div>
            </a>

            <div class="flex items-center space-x-3 hidden sm:flex">
                <a
                        href="tel:+393333107476"
                        class="inline-flex group relative items-center space-x-2.5 sm:space-x-3 bg-amber-500 hover:bg-amber-600 text-zinc-950 px-3.5 py-2.5 sm:px-5 sm:py-3 rounded-xl sm:rounded-2xl font-bold shadow-md shadow-amber-500/20 active:scale-95 transition-all duration-200"
                >
                    <div class="p-1.5 bg-white/30 rounded-lg sm:rounded-xl group-hover:rotate-12 transition-transform">
                        <Phone size={18}/>
                    </div>
                    <div class="flex flex-col text-left">
                        <span class="hidden sm:block text-[10px] uppercase tracking-wider font-semibold text-zinc-900/75 leading-none mb-0.5">Chiamaci</span>
                        <span class="text-xs sm:text-sm font-extrabold tracking-wide leading-tight">333 310 7476</span>
                    </div>
                </a>
            </div>

        </div>
    </div>
</header>